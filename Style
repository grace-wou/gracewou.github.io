style.css

body {
    font-family: Arial, sans-serif;
    margin: 0;
    line-height: 1.6;
    color: #222;
}

nav {
    padding: 20px;
    text-align: center;
    background: #f5f5f5;
}

nav a {
    margin: 0 15px;
    text-decoration: none;
    color: #222;
}

section {
    max-width: 900px;
    margin: auto;
    padding: 80px 30px;
}

h1 {
    font-size: 60px;
}

.project {
    padding: 25px;
    margin: 20px 0;
    border: 1px solid #ddd;
    border-radius: 10px;
}
